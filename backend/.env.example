# AwaazAI Backend Environment Configuration Example
APP_NAME="AwaazAI"
DEFAULT_PROVIDER="mock"

# Optional Cloud Providers (Can be plugged in without code changes)
SARVAM_API_KEY=""
FISH_AUDIO_API_KEY=""
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION="centralindia"
ELEVENLABS_API_KEY=""
GOOGLE_APPLICATION_CREDENTIALS=""

# Limits
MAX_CHAR_LIMIT=2500
RATE_LIMIT_PER_MINUTE=60

# 30-Day Premium Trial Limits
TRIAL_DAYS=30
TRIAL_TOTAL_PREMIUM_CHARS=10000
TRIAL_DAILY_PREMIUM_CHARS=1000
MAX_CHARS_PER_REQUEST_PREMIUM=500
MAX_CHARS_PER_REQUEST_FREE=2500
FREE_FALLBACK_DAILY_CHARS=3000

# Global Spend Guard & Kill Switch
GLOBAL_DAILY_PREMIUM_SPEND_CAP_INR=500.0
PREMIUM_KILL_SWITCH=False

# Authentication & Security
JWT_SECRET_KEY="generate-a-strong-random-secret-key-here"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
