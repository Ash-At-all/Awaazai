# AwaazAI Backend Environment Configuration Example
APP_NAME=AwaazAI
DEBUG=False
DEFAULT_PROVIDER=mock

# Database
DATABASE_URL=sqlite:///./awaazai.db

# Security & CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_KEY_SECRET=change-this-in-production-to-a-secure-random-key

# Limits
MAX_CHAR_LIMIT=2500
RATE_LIMIT_PER_MINUTE=30

# Optional Cloud Providers (Leave empty to use Mock/Edge offline TTS)
SARVAM_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
ELEVENLABS_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
